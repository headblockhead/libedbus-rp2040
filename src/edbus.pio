.pio_version 0                        ; These programs require version 0 (RP2040) features only.

.program edbus_tx
.side_set 1 opt pindirs               ; Optionally control 1 pin's state per instruction call. 
                                      ; This is used to control the EBC (clock) pin.
                                      ; For side_set to work, the EBC (clock) pin must be 1 after (to the side of) the EBD (data) pin.

abandon:                              ; This label is jumped to if a transmission is abandoned whilst in progress.
  mov osr, null                       ; Clear the output shift register (the register containing data pulled from the CPU).
  irq set 0                           ; Set IRQ 0 to alert the CPU to the error condition so it can attempt retransmission.
  wait 0 irq 0                        ; Wait for IRQ 0 to be cleared by the CPU before continuing.

public entry_point:                   ; This is the actual entry point of the program, where execution starts after being initalised.
.wrap_target                          ; The program will wrap around to this point after reaching the .wrap directive.
  irq clear 0                         ; Clear IRQ 0. IRQ 0 represents when a transmission has been abandoned.
  pull block                          ; Pull 32 bits from the TX FIFO into the OSR. If no data has been put into the FIFO, just wait.
                                      ; Data in the TX FIFO is data which has been sent by the CPU.
  wait 0 irq 7                        ; Wait until IRQ 7 is cleared (or proceed if it is already cleared).
                                      ; IRQ 7 is set and cleared by the edbus_rx program, and is set whilst the bus is busy.
  set x, 31                           ; Set register x to 31. Register x counts how many bits are left to transmit at the end of each write_bit loop.
  set pindirs, 0      side 0  [7]     ; Set EBD and EBC low, then wait another 7 cycles.
                                      ; This indicates a start condition.
write_bit:
  out y, 1                            ; Take one bit from the OSR, and place its value into the Y register.
  jmp !y do_zero                      ; If y is equal to 0, jump to do_zero. Otherwise, fall through to do_one.
do_one:
  set pindirs, 1      side 1  [2]     ; Set EBD high, and EBC high, then wait another 2 cycles.
  jmp pin check_loop                  ; If EBD is high, the 1 bit was successfully transmitted.
  jmp abandon                         ; Otherwise if EBD is low, another node has transmitted a 0 whilst we've tried to transmit a 1, so abandon transmission here.
do_zero:
  set pindirs, 0      side 1  [3]     ; Set EBD low, and EBC high, then wait another 3 cycles so that do_one and do_zero take the same number of cycles.
check_loop:
  jmp x-- write_bit   side 0          ; If register x is not zero, loop back to write_bit. Otherwise, fall through as the transmission has finished.
                                      ; Then, decrement the value of x, and set EBC low.
done:
  set pindirs, 1      side 1  [7]     ; Set EBD and EBC high, then wait another 7 cycles.
                                      ; This indicates a stop condition.
.wrap                                 ; Wrap back around to .wrap_target.

% c-sdk {
#include "hardware/gpio.h"

// edbus_tx_program_init intialises the edbus_tx program.
// pin_ebd and pin_ebc must be sequential: pin_ebc must be one after pin_ebd.
// The edbus_rx program must always be initalised prior to initailising the edbus_tx program for correct operation.
static inline void edbus_tx_program_init(PIO pio, uint sm, uint offset, uint pin_ebd, uint pin_ebc) {
    // EBC must be after EBD due to controlling EBC through side_set.
    assert(pin_ebc == pin_ebd + 1);
    // Create a new config based on the default options.
    pio_sm_config c = edbus_tx_program_get_default_config(offset);

    sm_config_set_set_pins(&c, pin_ebd, 1); // Make the 'set pins' and 'set pindirs' instructions manipulate the EBD pin.
    sm_config_set_jmp_pin(&c, pin_ebd); // Make the 'jmp pin' instruction read the state of the EBD pin.
    sm_config_set_sideset_pins(&c, pin_ebc); // Make the 'side 0' and 'side 1' side-set controls manipulate the EBC pin.

    // Join the RX and TX FIFO buffers into one large TX buffer, as this program only needs TX.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX); 

    // Run this program at half of the system clock speed.
    sm_config_set_clkdiv(&c, 2.0f);

    // Pull up both EBD and EBC.
    // 220Ω hardware resistors between EBD/EBC and 3.3V must be used in addition to this.
    // This makes both pins remain at logic level high by default, unless something drives them low.
    gpio_pull_up(pin_ebd);
    gpio_pull_up(pin_ebc);

    // Create a utility bitmask to control both EBD and EBC at the same time.
    uint32_t pin_mask = (1u << pin_ebd) | (1u << pin_ebc);

    // Pre-set EBD and EBC to output high, so that they don't glitch the bus when initialised.
    pio_sm_set_pins_with_mask(pio, sm, pin_mask, pin_mask); // Set both EBD and EBC high.
    pio_sm_set_pindirs_with_mask(pio, sm, pin_mask, pin_mask); // Set both EBD and EBC to direction 1 (currently the 'output' direction).

    // Initialise EBD and EBC.
    pio_gpio_init(pio, pin_ebd);
    pio_gpio_init(pio, pin_ebc);

    // Invert the output enable (direction) controls for EBD and EBC.
    // After this, direction 0 represents an output, and direction 1 represents an input.
    // As EBD and EBC are currently set to direction 1, applying this inversion makes both EBD and EBC become inputs.
    gpio_set_oeover(pin_ebd, GPIO_OVERRIDE_INVERT); 
    gpio_set_oeover(pin_ebc, GPIO_OVERRIDE_INVERT);

    // Pre-set EBD and EBC to low. This has no effect yet, as EBD and EBC are currently inputs.
    pio_sm_set_pins_with_mask(pio, sm, 0, pin_mask);

    // This setup allows operating the EBD and EBC pins as an 'open-drain' bus.
    // When EBD/EBC is set to direction 1, the pin becomes an input, so remains pulled up high by the pull-up resistors.
    // When EBD/EBC is set to direction 0, the pin becomes an output, and the pin is driven low.

    // The inversion of the direction controls is used to make the edbus_tx program easier to read.
    // 'set pindirs, 0' now drives EBD low, and 'set pindirs, 1' now leaves EBD high.

    // Initialise the state machine at the entry_point label.
    pio_sm_init(pio, sm, offset + edbus_tx_offset_entry_point, &c);
    // Enable the state machine.
    pio_sm_set_enabled(pio, sm, true);
}
%}

.program edbus_rx

public entry_point:                   ; Execution starts here.
.wrap_target                          ; The program will wrap around to this point after reaching the .wrap directive.
  irq clear 7                         ; Clear IRQ 7. IRQ 7 is set whilst edbus_rx determines the bus to be busy.
  wait 0 pin 1                        ; Wait for EBC to go low, indicating a potential start condition.
  irq set 7                   [3]     ; Set IRQ 7, as the bus appears to be busy. Then, wait another 3 cycles to set up the EBC check that follows.
  jmp pin entry_point                 ; If EBC reads as high 4 cycles after going low, this is not the start of a transmission, so jump back to the start and wait for EBC to go low again.
                                      ; Otherwise, this is the start of a transmission.
  set x, 31                           ; Set register x to 31. Register x counts how many bits are left to recieve at the end of each read_bit loop.
read_bit:                               
  wait 1 pin 1                [2]     ; Wait for EBC to go high, then wait another 2 cycles.
  in pins, 1                          ; Read the current state of the EBD pin into the ISR as a bit.
  jmp x-- read_bit                    ; If register x is not zero, loop back to read_bit. Otherwise, fall through as the transmission has finished.
  push block                          ; Push 32 bits from the ISR into the RX FIFO. If the FIFO is full, just wait.
                                      ; Data in the RX FIFO is data which has been sent to the CPU.
.wrap                                 ; Wrap back around to .wrap_target.

% c-sdk {
// edbus_rx_program_init intialises the edbus_rx program.
// pin_ebd and pin_ebc must be sequential: pin_ebc must be one after pin_ebd.
// The edbus_rx program must always be initalised prior to initailising the edbus_tx program for correct operation.
static inline void edbus_rx_program_init(PIO pio, uint sm, uint offset, uint pin_ebd, uint pin_ebc) {
    // EBC must be after EBD due to waiting on EBC through its relative pin index from EBD.
    assert(pin_ebc == pin_ebd + 1);
    // Create a new config based on the default options.
    pio_sm_config c = edbus_rx_program_get_default_config(offset);

    sm_config_set_in_pins(&c, pin_ebd); // Make the 'in pins' instruction read the state of the EBD pin.
    sm_config_set_jmp_pin(&c, pin_ebc); // Make the 'jmp pin' instruction read the state of the EBD pin.

    // Join the RX and TX FIFO buffers into one large RX buffer, as this program only needs RX.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    // Run this program at half of the system clock speed.
    sm_config_set_clkdiv(&c, 2.0f);

    // Initialise the state machine at the entry_point label.
    pio_sm_init(pio, sm, offset + edbus_rx_offset_entry_point, &c);
    // Enable the state machine.
    pio_sm_set_enabled(pio, sm, true);
}
%}
