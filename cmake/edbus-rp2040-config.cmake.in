@PACKAGE_INIT@

if(NOT TARGET edbus-rp2040::edbus-rp2040)
  add_library(edbus-rp2040::edbus-rp2040 STATIC IMPORTED)
  
  set_target_properties(edbus-rp2040::edbus-rp2040 PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libedbus-rp2040.a"
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
  )
endif()
